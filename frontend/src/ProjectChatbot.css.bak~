.chatbot-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding: 20px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.chatbot-card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  width: 100%;
  max-width: 600px;
  overflow: hidden;
  animation: slideUp 0.4s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.chatbot-step {
  padding: 48px 32px;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.chatbot-step h2 {
  font-size: 32px;
  font-weight: 800;
  margin-bottom: 16px;
  color: #1a1a1a;
}

.chatbot-step h3 {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 16px;
  color: #1a1a1a;
}

.chatbot-step h4 {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #1a1a1a;
}

.chatbot-step p {
  font-size: 15px;
  color: #666;
  margin-bottom: 12px;
  line-height: 1.6;
}

.step-subtitle {
  color: #999;
  font-size: 14px;
  margin-bottom: 24px;
}

/* OPTIONS GRID */
.options-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 12px;
  margin-bottom: 24px;
}

.option-btn {
  padding: 14px 16px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  background: white;
  color: #1a1a1a;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
}

.option-btn:hover {
  border-color: #004aad;
  background: #f0f5ff;
  transform: translateY(-2px);
}

.option-btn:active {
  background: #004aad;
  color: white;
  border-color: #004aad;
}

/* INPUTS */
.chatbot-textarea,
.chatbot-input {
  width: 100%;
  padding: 12px 16px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 15px;
  font-family: inherit;
  margin-bottom: 16px;
  transition: border-color 0.3s;
}

.chatbot-textarea:focus,
.chatbot-input:focus {
  outline: none;
  border-color: #004aad;
  box-shadow: 0 0 0 4px rgba(0, 74, 173, 0.1);
}

.chatbot-textarea {
  resize: vertical;
  min-height: 140px;
}

/* BUTTONS */
.button-group {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.chatbot-btn-primary,
.chatbot-btn-secondary {
  padding: 12px 24px;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  flex: 1;
}

.chatbot-btn-primary {
  background: #004aad;
  color: white;
}

.chatbot-btn-primary:hover:not(:disabled) {
  background: #003580;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(0, 74, 173, 0.3);
}

.chatbot-btn-primary:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.chatbot-btn-secondary {
  background: #f5f5f5;
  color: #1a1a1a;
  border: 1px solid #e0e0e0;
}

.chatbot-btn-secondary:hover {
  background: #e8e8e8;
  transform: translateY(-2px);
}

/* LOADING */
.loading {
  text-align: center;
  padding: 32px 0;
}

.spinner {
  width: 48px;
  height: 48px;
  border: 4px solid #e0e0e0;
  border-top: 4px solid #004aad;
  border-radius: 50%;
  margin: 0 auto 24px;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* SOLUTION BOX */
.solution-box {
  background: #f9f9f9;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  padding: 24px;
  margin-bottom: 24px;
  max-height: 400px;
  overflow-y: auto;
}

.solution-content {
  font-size: 14px;
  line-height: 1.8;
  color: #333;
}

.solution-content p {
  margin-bottom: 12px;
}

.solution-content strong {
  color: #004aad;
}

/* MESSAGES */
.error-message {
  background: #ffebee;
  color: #c62828;
  padding: 12px 16px;
  border-radius: 6px;
  font-size: 14px;
  margin-bottom: 16px;
  border-left: 4px solid #c62828;
}

.success-message {
  background: #e8f5e9;
  border: 2px solid #4caf50;
  border-radius: 8px;
  padding: 24px;
  text-align: center;
}

.success-message h4 {
  color: #2e7d32;
  margin-bottom: 8px;
}

.success-message p {
  color: #2e7d32;
  margin-bottom: 20px;
}

/* RESPONSIVE */
@media (max-width: 600px) {
  .chatbot-card {
    border-radius: 0;
  }

  .chatbot-step {
    padding: 32px 20px;
  }

  .chatbot-step h2 {
    font-size: 24px;
  }

  .chatbot-step h3 {
    font-size: 20px;
  }

  .options-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .button-group {
    flex-direction: column;
  }

  .chatbot-btn-primary,
  .chatbot-btn-secondary {
    width: 100%;
  }
}
